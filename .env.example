# Runtime
NODE_ENV=production
PORT=10000
APP_URL=https://YOUR-RENDER-SERVICE.onrender.com
VETRA_PIX_PRICE=17

# Render PostgreSQL: set DATABASE_URL from the database's Internal Database URL.
DATABASE_URL=
# Set true only if the database connection requires TLS (commonly external URLs).
DATABASE_SSL=false

# Mercado Pago production/test access token and webhook secret. Keep these only in Render Environment.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
